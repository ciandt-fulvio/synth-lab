# Development Dockerfile for synth-lab frontend
# Optimized for Vite HMR with volume mounts

FROM node:20-slim

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install ALL dependencies (including devDependencies)
RUN npm ci

# Source code will be mounted as volume at runtime
# Volume: ./frontend:/app
# Anonymous volume: /app/node_modules (preserves container's node_modules)

# Environment variables for HMR in Docker
ENV CHOKIDAR_USEPOLLING=true

# Expose Vite dev server port
EXPOSE 8080

# Start Vite dev server with host binding for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
