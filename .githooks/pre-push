#!/bin/bash
#
# Git pre-push hook: Fast anti-regression tests
# Runs smoke + contract tests (< 1 minute)
# Blocks push if tests fail (can bypass with --no-verify)
#

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}🧪 Running fast pre-push tests (smoke + contract + schema)...${NC}"
echo ""

# Run fast tests via Makefile (handles DB container + env vars)
if ! make test-fast; then
    echo ""
    echo -e "${RED}❌ Pre-push tests failed!${NC}"
    echo "   Fix failing tests before pushing."
    echo ""
    echo "   What failed:"
    echo "   - Smoke tests: Health checks (DB, configs, imports)"
    echo "   - Contract tests: API schemas that frontend expects"
    echo "   - Schema tests: DB schema validation"
    echo ""
    echo "   To run full test suite: make test"
    echo "   To bypass this check: git push --no-verify"
    echo ""
    exit 1
fi

echo ""
echo -e "${GREEN}✅ Fast tests passed! Proceeding with push...${NC}"
echo "   (Full test suite will run in CI)"
echo ""

exit 0
