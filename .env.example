# synth-lab Environment Configuration
# Copy this file to .env and configure for your environment
#
# For different environments, use:
#   .env              - Local development (default)
#   docker/.env.dev   - Docker development
#   docker/.env.test  - Docker testing (includes E2E)

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================

# PostgreSQL connection string
# Local:   postgresql://user:password@localhost:5432/synthlab
# Docker:  postgresql://synthlab:password@postgres:5432/synthlab
# Railway: Use the DATABASE_URL provided by Railway
DATABASE_URL=

# PostgreSQL credentials (for Docker Compose)
POSTGRES_USER=synthlab
POSTGRES_PASSWORD=
POSTGRES_DB=synthlab
POSTGRES_PORT=5432

# =============================================================================
# OpenAI Configuration (REQUIRED for LLM features)
# =============================================================================

OPENAI_API_KEY=

# =============================================================================
# Authentication Configuration (Google OAuth 2.0)
# =============================================================================

# Google OAuth Client Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# JWT Session Management
# Generate secret: openssl rand -hex 32
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Whitelist: comma-separated emails and domains
# Examples: user@example.com,admin@company.com,@company.com,@partner.org
# Domain format: @company.com allows any email from that domain
WHITELIST=

# =============================================================================
# S3 Storage Configuration (Railway Buckets)
# =============================================================================
# REQUIRED: Get credentials from Railway Dashboard > Project > Storage > Bucket
# Railway provides these automatically in production.
# For local dev/test, copy from Railway bucket credentials tab.

# Railway-style variable names (preferred)
ENDPOINT=https://storage.railway.app
BUCKET=bucket_name_here
BUCKET_ACCESS_KEY_ID=t1d_your_access_key_here
BUCKET_SECRET_ACCESS_KEY=tsec_your_secret_key_here
REGION=auto

# AWS-style fallbacks (optional, for AWS S3 compatibility)
# S3_ENDPOINT_URL=
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000

# URLs for E2E testing
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173

# =============================================================================
# Observability (optional)
# =============================================================================

PHOENIX_ENABLED=false
# PHOENIX_COLLECTOR_ENDPOINT=http://host.docker.internal:6006/v1/traces

# =============================================================================
# Development Settings
# =============================================================================

DEBUG=true
LOG_LEVEL=INFO

# Enable SQL query logging (for debugging)
# SQL_ECHO=true

# =============================================================================
# Docker Development Settings
# =============================================================================

# File watching for hot reload in Docker
WATCHFILES_FORCE_POLLING=true
CHOKIDAR_USEPOLLING=true

# Frontend configuration (Docker)
VITE_PORT=5173
VITE_API_PORT=8000
# VITE_BACKEND_HOST=backend
